# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/habeas_db

# Email Service Configuration
# AWS SES (Primary Email Service - Cost Optimized)
USE_AWS_SES=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
SES_FROM_EMAIL=alerts@habeas.app
SES_CONFIGURATION_SET=habeas-production

# SendGrid (Legacy Fallback during migration)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@habeas.app

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Frontend URL for notification links
FRONTEND_URL=https://habeas.app

# Development/Testing
# Set to "development" to disable actual notifications and log instead
NOTIFICATION_MODE=production

# Testing Configuration
TEST_EMAIL=test@example.com

# Celery Background Job System
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis Configuration (if using separate Redis instance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Background Job Configuration
# Daily digest time (24-hour format UTC)
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0

# Escalated notification check interval (minutes)
ESCALATED_CHECK_INTERVAL=15

# Job retry configuration
MAX_TASK_RETRIES=3
TASK_RETRY_DELAY=300
